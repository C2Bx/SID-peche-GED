{% extends "base.html.j2" %}
{% block content %}
<header class="page">
  <div>
    <h1>{{ title }}</h1>
    <p class="meta">Source : {{ source }} · généré le {{ generated_at }}</p>
  </div>
  <div class="chips" aria-label="Années couvertes">
    {% for year in years %}<span class="chip">{{ year }}</span>{% endfor %}
  </div>
</header>

<section class="kpis" aria-label="Indicateurs clés">
  {% for kpi in kpis %}
  <div class="card kpi">
    <div class="label">{{ kpi.label }}</div>
    <div class="value">{{ kpi.value }}{% if kpi.unit %} <span class="unit">{{ kpi.unit }}</span>{% endif %}</div>
    {% if kpi.detail %}<div class="detail">{{ kpi.detail }}</div>{% endif %}
  </div>
  {% endfor %}
</section>

<p class="warning">
  Les montants viennent du grain <strong>campagne</strong> et sont recopiés de la
  source sans recalcul. Aucun graphique n'utilise l'axe navire : il désigne le
  navire autorisé sur la carte, pas forcément celui de la campagne.
</p>

<div class="grid">
  {% for section in sections %}
  <section class="card{% if section.wide %} wide{% endif %}" id="{{ section.id }}">
    <header>
      <h2>{{ section.title }}</h2>
      <p class="subtitle">{{ section.subtitle }}</p>
    </header>
    {{ section.chart_html | safe }}
    {% if section.note %}<p class="note">{{ section.note }}</p>{% endif %}
    <details>
      <summary>Voir les données</summary>
      <div class="table-wrap">{{ section.table_html | safe }}</div>
    </details>
  </section>
  {% endfor %}

  <section class="card wide" id="qualite">
    <header>
      <h2>Qualité des données</h2>
      <p class="subtitle">Contrôles repris du script DTM — 0 attendu</p>
    </header>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Contrôle</th><th>Statut</th><th>Campagnes</th><th>Part</th><th class="text">Lecture</th></tr></thead>
        <tbody>
        {% for check in quality %}
          <tr>
            <td>{{ check.label }}</td>
            <td><span class="status {{ 'ok' if check.ok else 'ko' }}">{{ '✓ Conforme' if check.ok else '⚠ À vérifier' }}</span></td>
            <td>{{ check.count }}</td>
            <td>{{ check.share }}</td>
            <td class="text">{{ check.explanation }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</div>

<footer>
  Généré par <code>python -m reporting.build_report</code> · SID Pêche Province Sud
</footer>
{% endblock %}
