-- ============================================================================
-- 1. DIMENSIONS  (SFD §6.3)
-- ============================================================================
-- Toutes les dimensions portent une clé de substitution et un membre
-- « inconnu » de clé -1. Les faits ne contiennent donc jamais de NULL en clé
-- étrangère : aucune jointure ne perd de lignes en silence. La clé métier est
-- conservée en attribut, pour pouvoir remonter à la source.


-- ---- DIM_TEMPS : calendrier CONTINU -----------------------------------------
-- Une dimension temps se génère, elle ne se déduit pas des données observées :
-- sinon les jours sans activité manquent et l'on ne peut plus ni compter les
-- mois creux, ni faire de cumul glissant.
-- Clé au format AAAAMMJJ. Bornes 1990-2030 : la source commence en 1991.

CREATE TABLE DIM_TEMPS (
    temps_key    INT          NOT NULL PRIMARY KEY,
    date_id      DATE         NULL,
    jour         TINYINT      NULL,
    mois         TINYINT      NULL,
    trimestre    TINYINT      NULL,
    annee        SMALLINT     NULL,
    libelle_mois NVARCHAR(20) NULL,
    jour_semaine NVARCHAR(20) NULL,
    saison       NVARCHAR(20) NULL
);

INSERT INTO DIM_TEMPS (temps_key, date_id, jour, mois, trimestre, annee,
                       libelle_mois, jour_semaine, saison)
VALUES (-1, NULL, NULL, NULL, NULL, NULL, 'Inconnu', 'Inconnu', 'Inconnu');

WITH jours AS (
    SELECT CAST('1990-01-01' AS DATE) AS d
    UNION ALL
    SELECT DATEADD(DAY, 1, d) FROM jours WHERE d < '2030-12-31'
)
INSERT INTO DIM_TEMPS (temps_key, date_id, jour, mois, trimestre, annee,
                       libelle_mois, jour_semaine, saison)
SELECT CONVERT(INT, FORMAT(d, 'yyyyMMdd')), d,
       DAY(d), MONTH(d), DATEPART(QUARTER, d), YEAR(d),
       DATENAME(MONTH, d), DATENAME(WEEKDAY, d),
       -- hémisphère sud : l'été calédonien est à cheval sur deux années
       CASE WHEN MONTH(d) IN (12,1,2) THEN 'Été'
            WHEN MONTH(d) IN (3,4,5)  THEN 'Automne'
            WHEN MONTH(d) IN (6,7,8)  THEN 'Hiver'
            ELSE 'Printemps' END
FROM jours
OPTION (MAXRECURSION 0);
GO


-- ---- DIM_COMMUNE ------------------------------------------------------------
-- Axe d'analyse à part entière (SFD : répartition des pêcheurs par commune).
-- La laisser en texte dans plusieurs dimensions interdit de la regrouper.

CREATE TABLE DIM_COMMUNE (
    commune_key INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    commune     NVARCHAR(200) NULL
);

SET IDENTITY_INSERT DIM_COMMUNE ON;
INSERT INTO DIM_COMMUNE (commune_key, commune) VALUES (-1, 'Non renseignée');
SET IDENTITY_INSERT DIM_COMMUNE OFF;

INSERT INTO DIM_COMMUNE (commune)
SELECT DISTINCT LTRIM(RTRIM(c))
FROM (
    SELECT capitaine_commune AS c FROM peche_nc.env_mer.pecheur_anonymise
    UNION SELECT patron_pecheur_commune FROM peche_nc.env_mer.pecheur_anonymise
    UNION SELECT carte_autorisation_commune FROM peche_nc.env_mer.pecheur_anonymise
) AS x
WHERE c IS NOT NULL AND LTRIM(RTRIM(c)) <> '';
GO


-- ---- DIM_PERSONNE : capitaines et patrons pêcheurs, fusionnés ---------------
-- CORRECTIF. La version précédente filtrait avec
--   WHERE patron_pecheur_id NOT IN (SELECT personne_id FROM DIM_PERSONNE)
-- à l'intérieur de l'INSERT qui remplit DIM_PERSONNE : la sous-requête voit la
-- table telle qu'elle était au début de l'instruction, c'est-à-dire vide. Le
-- filtre ne filtrait rien, et l'UNION ne dédoublonnait que les lignes
-- entières. 214 identifiants étant à la fois capitaine et patron, il suffisait
-- d'une commune différente entre les deux rôles pour produire deux lignes de
-- même identifiant — et la clé primaire rejetait l'insertion.
--
-- On agrège donc en une seule passe, sur l'union des deux rôles, avec deux
-- drapeaux qui disent lequel la personne a tenu.

CREATE TABLE DIM_PERSONNE (
    personne_key    INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    personne_id     VARCHAR(255)  NULL,
    commune_key     INT           NOT NULL,
    date_naissance  DATE          NULL,
    annee_naissance SMALLINT      NULL,
    sexe            NVARCHAR(60)  NULL,
    est_capitaine   BIT           NOT NULL,
    est_patron      BIT           NOT NULL
);

SET IDENTITY_INSERT DIM_PERSONNE ON;
INSERT INTO DIM_PERSONNE (personne_key, personne_id, commune_key,
                          date_naissance, annee_naissance, sexe,
                          est_capitaine, est_patron)
VALUES (-1, NULL, -1, NULL, NULL, 'Inconnu', 0, 0);
SET IDENTITY_INSERT DIM_PERSONNE OFF;

WITH roles AS (
    SELECT capitaine_id AS personne_id, capitaine_commune AS commune,
           capitaine_date_naissance AS naissance, capitaine_sexe AS sexe,
           1 AS capitaine, 0 AS patron
    FROM peche_nc.env_mer.pecheur_anonymise
    WHERE capitaine_id IS NOT NULL
    UNION ALL
    SELECT patron_pecheur_id, patron_pecheur_commune,
           patron_pecheur_date_naissance, patron_pecheur_sexe, 0, 1
    FROM peche_nc.env_mer.pecheur_anonymise
    WHERE patron_pecheur_id IS NOT NULL
)
INSERT INTO DIM_PERSONNE (personne_id, commune_key, date_naissance,
                          annee_naissance, sexe, est_capitaine, est_patron)
SELECT r.personne_id,
       ISNULL(dc.commune_key, -1),
       MAX(r.naissance),
       CASE WHEN YEAR(MAX(r.naissance)) BETWEEN 1900 AND 2030
            THEN YEAR(MAX(r.naissance)) END,
       MAX(r.sexe),
       MAX(r.capitaine), MAX(r.patron)
FROM roles r
LEFT JOIN DIM_COMMUNE dc ON dc.commune = LTRIM(RTRIM(r.commune))
GROUP BY r.personne_id, ISNULL(dc.commune_key, -1);
GO


-- ---- DIM_CARTE : attributs descriptifs de la carte, pas les mesures ---------

CREATE TABLE DIM_CARTE (
    carte_key                   INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    carte_id                    VARCHAR(255)  NULL,
    carte_type                  NVARCHAR(120) NULL,   -- libellé normalisé
    carte_type_source           NVARCHAR(120) NULL,   -- libellé brut conservé
    carte_annee                 VARCHAR(20)   NULL,
    carte_renouvellement        BIT           NULL,
    carte_autorisation_statut   NVARCHAR(120) NULL,
    carte_autorisation_annee    VARCHAR(20)   NULL,
    commune_key                 INT           NOT NULL,
    carte_autorisation_province NVARCHAR(120) NULL
);

SET IDENTITY_INSERT DIM_CARTE ON;
INSERT INTO DIM_CARTE (carte_key, carte_id, carte_type, carte_type_source,
                       commune_key)
VALUES (-1, NULL, 'Inconnu', NULL, -1);
SET IDENTITY_INSERT DIM_CARTE OFF;

-- 35 ans de saisie ont produit cinq orthographes pour deux types de carte
-- (« Côtière », « Cotière », « CÃ´tiÃ¨re » doublement encodée à la source,
-- « Hauturière », « Haurière »). On normalise pour l'affichage tout en
-- gardant la variante brute : elle date le changement de système de saisie.
INSERT INTO DIM_CARTE (carte_id, carte_type, carte_type_source, carte_annee,
                       carte_renouvellement, carte_autorisation_statut,
                       carte_autorisation_annee, commune_key,
                       carte_autorisation_province)
SELECT p.carte_id,
       CASE
         WHEN p.carte_type LIKE 'C%ti%re' OR p.carte_type LIKE 'C%tiere' THEN N'Côtière'
         WHEN p.carte_type LIKE 'Ha%ri%re' OR p.carte_type LIKE 'Haut%'  THEN N'Hauturière'
         ELSE p.carte_type
       END,
       p.carte_type,
       p.carte_annee, p.carte_renouvellement, p.carte_autorisation_statut,
       p.carte_autorisation_annee,
       ISNULL(dc.commune_key, -1),
       p.carte_autorisation_province
FROM peche_nc.env_mer.pecheur_anonymise p
LEFT JOIN DIM_COMMUNE dc
       ON dc.commune = LTRIM(RTRIM(p.carte_autorisation_commune));
GO


-- ---- DIM_NAVIRE -------------------------------------------------------------
-- La motorisation est repliée ici (nombre de moteurs, marque et carburant du
-- moteur principal) : c'est ainsi qu'on l'interroge, et cela évite de faire
-- une dimension d'une table qu'aucun fait ne référence.
-- 235 navires sur 660 ne déclarent aucun moteur ; c'est la source, pas l'import.

CREATE TABLE DIM_NAVIRE (
    navire_key            INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    navire_id             VARCHAR(255)  NULL,
    annee_construction    INT           NULL,
    longueur              FLOAT         NULL,
    tranche_longueur      NVARCHAR(30)  NULL,
    jauge_brute           FLOAT         NULL,
    origine               NVARCHAR(120) NULL,
    categorie_navigation  NVARCHAR(120) NULL,
    materiau              NVARCHAR(120) NULL,
    constructeur          NVARCHAR(200) NULL,
    nb_moteurs            INT           NULL,
    moteur_marque         NVARCHAR(120) NULL,
    moteur_carburant      NVARCHAR(60)  NULL
);

SET IDENTITY_INSERT DIM_NAVIRE ON;
INSERT INTO DIM_NAVIRE (navire_key, navire_id, tranche_longueur, nb_moteurs)
VALUES (-1, NULL, 'Inconnue', 0);
SET IDENTITY_INSERT DIM_NAVIRE OFF;

INSERT INTO DIM_NAVIRE (navire_id, annee_construction, longueur,
                        tranche_longueur, jauge_brute, origine,
                        categorie_navigation, materiau, constructeur,
                        nb_moteurs, moteur_marque, moteur_carburant)
SELECT n.navire_id,
       -- l'année arrive en texte et n'est pas toujours numérique
       TRY_CONVERT(INT, n.navire_annee_construction),
       -- une longueur nulle ou négative n'a pas de sens physique
       CASE WHEN n.navire_longueur > 0 THEN n.navire_longueur END,
       CASE WHEN n.navire_longueur IS NULL OR n.navire_longueur <= 0 THEN 'Inconnue'
            WHEN n.navire_longueur <  6 THEN 'Moins de 6 m'
            WHEN n.navire_longueur < 10 THEN '6 à 10 m'
            WHEN n.navire_longueur < 15 THEN '10 à 15 m'
            ELSE '15 m et plus' END,
       CASE WHEN n.navire_jauge_brute > 0 THEN n.navire_jauge_brute END,
       n.navire_origine, n.categorie_navigation, n.materiau, n.constructeur,
       ISNULL(m.nb, 0), m.marque, m.carburant
FROM peche_nc.env_mer.navire_peche_anonymise n
LEFT JOIN (
    SELECT navire_id,
           COUNT(*) AS nb,
           MAX(marque)    AS marque,
           MAX(carburant) AS carburant
    FROM peche_nc.env_mer.navire_moteur
    GROUP BY navire_id
) m ON m.navire_id = n.navire_id;
GO


-- ---- DIM_ESPECE : hiérarchie Catégorie -> Produit (SFD) ---------------------
-- Clé de substitution plutôt qu'une PK (categorie_code, produit) : celle-ci
-- portait sur du NVARCHAR(4000), très au-delà des 900 octets admis pour une
-- clé d'index — accepté avec un avertissement, puis cassant le jour où un
-- libellé dépasse.

CREATE TABLE DIM_ESPECE (
    espece_key      INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    categorie_code  VARCHAR(255)  NULL,
    categorie_nom   NVARCHAR(255) NULL,
    produit         NVARCHAR(400) NULL,
    seuil_fiab70    FLOAT         NULL,
    seuil_fiab95    FLOAT         NULL
);

SET IDENTITY_INSERT DIM_ESPECE ON;
INSERT INTO DIM_ESPECE (espece_key, categorie_nom, produit)
VALUES (-1, 'Inconnue', 'Inconnu');
SET IDENTITY_INSERT DIM_ESPECE OFF;

INSERT INTO DIM_ESPECE (categorie_code, categorie_nom, produit,
                        seuil_fiab70, seuil_fiab95)
SELECT capture_categorie_code,
       MAX(capture_categorie_nom),
       LEFT(capture_produit, 400),
       MAX(capture_categorie_seuil_fiabilite70),
       MAX(capture_categorie_seuil_fiabilite95)
FROM peche_nc.env_mer.capture_peche
WHERE capture_categorie_code IS NOT NULL
GROUP BY capture_categorie_code, LEFT(capture_produit, 400);
GO


-- ---- DIM_TECHNIQUE ----------------------------------------------------------
-- CORRECTIF. Son grain est le COUPLE (technique, transformation) : 14
-- techniques pour 129 couples. Le fait ne portant que « technique », une
-- jointure multipliait chaque capture par 9,2 en moyenne, et aucune clé ne le
-- signalait. On lui donne une clé de substitution, et c'est elle que le fait
-- référence : le grain redevient cohérent.

CREATE TABLE DIM_TECHNIQUE (
    technique_key  INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    technique      NVARCHAR(200) NULL,
    transformation NVARCHAR(200) NULL
);

SET IDENTITY_INSERT DIM_TECHNIQUE ON;
INSERT INTO DIM_TECHNIQUE (technique_key, technique, transformation)
VALUES (-1, 'Inconnue', 'Inconnue');
SET IDENTITY_INSERT DIM_TECHNIQUE OFF;

INSERT INTO DIM_TECHNIQUE (technique, transformation)
SELECT DISTINCT LEFT(capture_technique, 200), LEFT(capture_transformation, 200)
FROM peche_nc.env_mer.capture_peche
WHERE capture_technique IS NOT NULL OR capture_transformation IS NOT NULL;
GO


-- ---- DIM_ZONE_PECHE ---------------------------------------------------------
-- L'ODS n'expose pas de référentiel de zones : on le reconstruit par
-- déduplication depuis capture_zone, en récupérant au passage la commune et la
-- superficie que porte le carroyage.

CREATE TABLE DIM_ZONE_PECHE (
    zone_key       INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    zone_peche_id  VARCHAR(255)  NULL,
    label          NVARCHAR(400) NULL,
    communes       NVARCHAR(500) NULL,
    superficie_km2 FLOAT         NULL
);

SET IDENTITY_INSERT DIM_ZONE_PECHE ON;
INSERT INTO DIM_ZONE_PECHE (zone_key, zone_peche_id, label)
VALUES (-1, NULL, 'Zone inconnue');
SET IDENTITY_INSERT DIM_ZONE_PECHE OFF;

INSERT INTO DIM_ZONE_PECHE (zone_peche_id, label, communes, superficie_km2)
SELECT z.zone_peche_id, MAX(z.label),
       -- plusieurs communes peuvent se partager une zone
       (SELECT STRING_AGG(CAST(c.carroyage_commune AS NVARCHAR(100)), ', ')
        FROM peche_nc.env_mer.carroyage_peche c
        WHERE c.coarroyage_zone_peche_id = z.zone_peche_id),
       (SELECT SUM(c.carroyage_superficie_nv_carroyage_km2)
        FROM peche_nc.env_mer.carroyage_peche c
        WHERE c.coarroyage_zone_peche_id = z.zone_peche_id)
FROM peche_nc.env_mer.capture_zone z
WHERE z.zone_peche_id IS NOT NULL
GROUP BY z.zone_peche_id;
GO


-- ---- DIM_CARROYAGE ----------------------------------------------------------
-- Conservée telle quelle, avec le lien vers la zone : c'est la maille
-- géographique fine, utile pour une restitution cartographique.

CREATE TABLE DIM_CARROYAGE (
    carroyage_key         INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    carroyage_id          INT           NULL,
    commune               NVARCHAR(50)  NULL,
    eth                   NVARCHAR(50)  NULL,
    zone_ancienne         NVARCHAR(50)  NULL,
    zone_nouvelle         NVARCHAR(50)  NULL,
    zone_peche_id_associe VARCHAR(255)  NULL,
    zone_key              INT           NOT NULL,
    superficie_km2        FLOAT         NULL
);

INSERT INTO DIM_CARROYAGE (carroyage_id, commune, eth, zone_ancienne,
                           zone_nouvelle, zone_peche_id_associe, zone_key,
                           superficie_km2)
SELECT c.carroyage_id, c.carroyage_commune, c.carroyage_eth,
       c.carroyage_zone_peche, c.carroyage_nouvelle_zone_peche,
       c.coarroyage_zone_peche_id,
       ISNULL(z.zone_key, -1),
       c.carroyage_superficie_nv_carroyage_km2
FROM peche_nc.env_mer.carroyage_peche c
LEFT JOIN DIM_ZONE_PECHE z ON z.zone_peche_id = c.coarroyage_zone_peche_id;
GO


-- ---- DIM_PECHERIE : pêcheries spécifiques autorisées sur une carte ----------

CREATE TABLE DIM_PECHERIE (
    pecherie_key INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    code         NVARCHAR(60)  NULL,
    nom          NVARCHAR(400) NULL,
    zone         NVARCHAR(200) NULL,
    taille_mini  NVARCHAR(120) NULL,
    periode      NVARCHAR(200) NULL,
    quota        NVARCHAR(200) NULL
);

SET IDENTITY_INSERT DIM_PECHERIE ON;
INSERT INTO DIM_PECHERIE (pecherie_key, code, nom) VALUES (-1, NULL, 'Inconnue');
SET IDENTITY_INSERT DIM_PECHERIE OFF;

INSERT INTO DIM_PECHERIE (code, nom, zone, taille_mini, periode, quota)
SELECT code, MAX(LTRIM(RTRIM(nom))), MAX(zone), MAX(taille),
       MAX(periode), MAX(quantite)
FROM peche_nc.env_mer.carte_pecherie_specifique
WHERE code IS NOT NULL
GROUP BY code;
GO


-- ============================================================================
-- 2. TABLES DE FAITS  (SFD §6.5)
-- ============================================================================


-- ---- FAIT_CARTE : grain = une carte de pêche, pour une année ----------------
--
--   ATTENTION — FAIT_CARTE EST UN AGRÉGAT.
--   Ses mesures sont la somme des campagnes rattachées à la carte. Ne JAMAIS
--   additionner FAIT_CARTE.recette et FAIT_CAMPAGNE.recette : le même chiffre
--   d'affaires serait compté deux fois. Utilisez l'une ou l'autre selon le
--   grain de la question, jamais les deux dans la même somme.

CREATE TABLE FAIT_CARTE (
    carte_id             VARCHAR(255) NOT NULL PRIMARY KEY,
    carte_key            INT NOT NULL,
    temps_key            INT NOT NULL,
    capitaine_key        INT NOT NULL,
    patron_key           INT NOT NULL,
    navire_key           INT NOT NULL,
    commune_key          INT NOT NULL,
    carte_benefice       FLOAT NULL,
    carte_depense        FLOAT NULL,
    carte_recette        FLOAT NULL,
    carte_rendement      FLOAT NULL,
    carte_carburant_qte  FLOAT NULL,
    carte_maree          INT   NULL,
    carte_tonnage_epe    FLOAT NULL
);

INSERT INTO FAIT_CARTE (carte_id, carte_key, temps_key, capitaine_key,
                        patron_key, navire_key, commune_key,
                        carte_benefice, carte_depense, carte_recette,
                        carte_rendement, carte_carburant_qte, carte_maree,
                        carte_tonnage_epe)
SELECT p.carte_id,
       ISNULL(dc.carte_key, -1),
       -- une date hors du calendrier bascule sur le membre inconnu
       CASE WHEN p.carte_date_delivrance IS NOT NULL
             AND YEAR(p.carte_date_delivrance) BETWEEN 1990 AND 2030
            THEN CONVERT(INT, FORMAT(p.carte_date_delivrance, 'yyyyMMdd'))
            ELSE -1 END,
       ISNULL(cap.personne_key, -1),
       ISNULL(pat.personne_key, -1),
       ISNULL(dn.navire_key, -1),
       ISNULL(dcom.commune_key, -1),
       p.carte_benefice, p.carte_depense, p.carte_recette, p.carte_rendement,
       p.carte_carburant_qte,
       -- un compteur de marées négatif est une saisie fautive
       CASE WHEN p.carte_maree >= 0 THEN p.carte_maree END,
       p.carte_tonnage_epe
FROM peche_nc.env_mer.pecheur_anonymise p
LEFT JOIN DIM_CARTE    dc  ON dc.carte_id  = p.carte_id
LEFT JOIN DIM_PERSONNE cap ON cap.personne_id = p.capitaine_id
LEFT JOIN DIM_PERSONNE pat ON pat.personne_id = p.patron_pecheur_id
LEFT JOIN DIM_NAVIRE   dn  ON dn.navire_id = p.carte_autorisation_navire_id
LEFT JOIN DIM_COMMUNE  dcom ON dcom.commune = LTRIM(RTRIM(p.capitaine_commune));
GO


-- ---- FAIT_CAMPAGNE : grain = une campagne (une sortie) ----------------------

CREATE TABLE FAIT_CAMPAGNE (
    campagne_id               VARCHAR(255) NOT NULL PRIMARY KEY,
    carte_key                 INT NOT NULL,
    navire_key                INT NOT NULL,
    temps_debut_key           INT NOT NULL,
    temps_fin_key             INT NOT NULL,
    duree_jours               INT   NULL,
    campagne_benefice         FLOAT NULL,
    campagne_depense          FLOAT NULL,
    campagne_recette          FLOAT NULL,
    campagne_rendement        FLOAT NULL,
    campagne_carburant_qte    FLOAT NULL,
    campagne_charges_sociales FLOAT NULL,
    campagne_jours_mer        FLOAT NULL,
    campagne_jours_peche      FLOAT NULL,
    campagne_nbre_equipage    FLOAT NULL,
    campagne_nbr_femme_abord  INT   NULL,
    campagne_salaire_matelots FLOAT NULL,
    campagne_salaire_patron   FLOAT NULL,
    campagne_tonnage_epe      FLOAT NULL
);

INSERT INTO FAIT_CAMPAGNE (campagne_id, carte_key, navire_key,
                           temps_debut_key, temps_fin_key, duree_jours,
                           campagne_benefice, campagne_depense,
                           campagne_recette, campagne_rendement,
                           campagne_carburant_qte, campagne_charges_sociales,
                           campagne_jours_mer, campagne_jours_peche,
                           campagne_nbre_equipage, campagne_nbr_femme_abord,
                           campagne_salaire_matelots, campagne_salaire_patron,
                           campagne_tonnage_epe)
SELECT c.campagne_id,
       ISNULL(dc.carte_key, -1),
       ISNULL(fc.navire_key, -1),
       CASE WHEN c.campagne_date_debut IS NOT NULL
             AND YEAR(c.campagne_date_debut) BETWEEN 1990 AND 2030
            THEN CONVERT(INT, FORMAT(c.campagne_date_debut, 'yyyyMMdd'))
            ELSE -1 END,
       CASE WHEN c.campagne_date_fin IS NOT NULL
             AND YEAR(c.campagne_date_fin) BETWEEN 1990 AND 2030
            THEN CONVERT(INT, FORMAT(c.campagne_date_fin, 'yyyyMMdd'))
            ELSE -1 END,
       -- durée neutralisée si la fin précède le début : cela relève du
       -- rapport d'anomalies, pas d'une valeur négative absurde
       CASE WHEN c.campagne_date_fin IS NULL OR c.campagne_date_debut IS NULL
            THEN NULL
            WHEN c.campagne_date_fin < c.campagne_date_debut THEN NULL
            ELSE DATEDIFF(DAY, c.campagne_date_debut, c.campagne_date_fin)
       END,
       c.campagne_benefice, c.campagne_depense, c.campagne_recette,
       c.campagne_rendement, c.campagne_carburant_qte,
       c.campagne_charges_sociales, c.campagne_jours_mer,
       c.campagne_jours_peche, c.campagne_nbre_equipage,
       c.campagne_nbr_femme_abord, c.campagne_salaire_matelots,
       c.campagne_salaire_patron, c.campagne_tonnage_epe
FROM peche_nc.env_mer.campagne_peche c
LEFT JOIN DIM_CARTE  dc ON dc.carte_id = c.campagne_carte_id
LEFT JOIN FAIT_CARTE fc ON fc.carte_id = c.campagne_carte_id;
GO


-- ---- FAIT_CAPTURE : grain = une espèce capturée lors d'une campagne ---------
-- La zone n'y figure PAS : une capture en porte jusqu'à 6, l'y mettre
-- multiplierait la ligne et donc le poids. Voir PONT_CAPTURE_ZONE.

CREATE TABLE FAIT_CAPTURE (
    capture_id                 VARCHAR(255) NOT NULL PRIMARY KEY,
    campagne_id                VARCHAR(255) NULL,   -- dimension dégénérée
    carte_key                  INT NOT NULL,
    navire_key                 INT NOT NULL,
    temps_key                  INT NOT NULL,
    espece_key                 INT NOT NULL,
    technique_key              INT NOT NULL,
    capture_nombre             FLOAT NULL,
    capture_poids_entier_total FLOAT NULL,
    capture_poids_transf_total FLOAT NULL,
    capture_valeurxpf          FLOAT NULL
);

INSERT INTO FAIT_CAPTURE (capture_id, campagne_id, carte_key, navire_key,
                          temps_key, espece_key, technique_key,
                          capture_nombre, capture_poids_entier_total,
                          capture_poids_transf_total, capture_valeurxpf)
SELECT cap.capture_id,
       cap.capture_campagne_id,
       ISNULL(fca.carte_key, -1),
       ISNULL(fca.navire_key, -1),
       -- la capture n'a pas de date propre : on prend celle de sa campagne
       ISNULL(fca.temps_debut_key, -1),
       ISNULL(de.espece_key, -1),
       ISNULL(dt.technique_key, -1),
       cap.capture_nombre, cap.capture_poids_entier_total,
       cap.capture_poids_transf_total, cap.capture_valeurxpf
FROM peche_nc.env_mer.capture_peche cap
LEFT JOIN FAIT_CAMPAGNE fca ON fca.campagne_id = cap.capture_campagne_id
LEFT JOIN DIM_ESPECE de
       ON de.categorie_code = cap.capture_categorie_code
      AND de.produit = LEFT(cap.capture_produit, 400)
LEFT JOIN DIM_TECHNIQUE dt
       ON dt.technique = LEFT(cap.capture_technique, 200)
      AND dt.transformation = LEFT(cap.capture_transformation, 200);
GO


-- ---- FAIT_FRAIS : grain = un poste de dépense d'une campagne ----------------
-- Déjà à ce grain dans l'ODS. Clé primaire ajoutée : sans elle, un
-- rechargement doublerait les montants sans que rien ne le signale.

CREATE TABLE FAIT_FRAIS (
    campagne_id   VARCHAR(255) NOT NULL,
    frais_id      VARCHAR(255) NOT NULL,
    nature_frais  NVARCHAR(255) NULL,
    carte_key     INT NOT NULL,
    navire_key    INT NOT NULL,
    temps_key     INT NOT NULL,
    montant       FLOAT NULL,
    CONSTRAINT PK_FAIT_FRAIS PRIMARY KEY (campagne_id, frais_id)
);

INSERT INTO FAIT_FRAIS (campagne_id, frais_id, nature_frais, carte_key,
                        navire_key, temps_key, montant)
SELECT cf.campagne_id, cf.frais_id, f.libelle,
       ISNULL(fca.carte_key, -1),
       ISNULL(fca.navire_key, -1),
       ISNULL(fca.temps_debut_key, -1),
       cf.montant
FROM peche_nc.env_mer.campagne_frais cf
JOIN peche_nc.env_mer.frais f ON f.frais_id = cf.frais_id
LEFT JOIN FAIT_CAMPAGNE fca ON fca.campagne_id = cf.campagne_id;
GO


