<!doctype html>
<html lang="fr" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if refresh_seconds %}<meta http-equiv="refresh" content="{{ refresh_seconds }}">{% endif %}
<title>{{ title }}</title>
<script>
// Mode jour par défaut ; le choix du visiteur est retenu d'une visite à
// l'autre. Appliqué avant l'affichage pour éviter un flash de couleur.
(function () {
  try {
    if (localStorage.getItem("sid-theme") === "dark") {
      document.documentElement.setAttribute("data-theme", "dark");
    }
  } catch (e) {}
})();
</script>
<style>
:root {
  color-scheme: light;
  --surface-0: #f4f3f0;
  --surface-1: #fcfcfb;
  --surface-2: #f0efec;
  --border: #e4e3df;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --text-muted: #7a7974;
  --accent: #2a78d6;
  --accent-soft: #e8f1fc;
  --chart-text: #52514e;
  --chart-grid: #e4e3df;
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #121211;
  --surface-1: #1a1a19;
  --surface-2: #232321;
  --border: #383835;
  --text-primary: #ffffff;
  --text-secondary: #c3c2b7;
  --text-muted: #8f8e86;
  --accent: #3987e5;
  --accent-soft: #1b2a3d;
  --chart-text: #c3c2b7;
  --chart-grid: #383835;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--surface-0);
  color: var(--text-primary);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  transition: background-color .2s, color .2s;
}
main { max-width: 1280px; margin: 0 auto; padding: 24px 16px 64px; }

/* En-tête ---------------------------------------------------------------- */
header.page { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center;
  justify-content: space-between; margin-bottom: 12px; }
h1 { font-size: 24px; line-height: 1.2; margin: 0 0 4px; letter-spacing: -0.01em; }
.meta { color: var(--text-secondary); font-size: 13px; margin: 0; }
.theme-toggle { display: inline-flex; border: 1px solid var(--border); border-radius: 999px;
  background: var(--surface-1); padding: 3px; gap: 2px; }
.theme-toggle button { border: 0; background: transparent; color: var(--text-secondary);
  font: inherit; font-size: 13px; padding: 5px 12px; border-radius: 999px; cursor: pointer; }
.theme-toggle button[aria-pressed="true"] { background: var(--accent); color: #fff; }
.theme-toggle button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* Navigation par thème -------------------------------------------------- */
nav.themes { position: sticky; top: 0; z-index: 5; display: flex; gap: 6px; flex-wrap: wrap;
  padding: 10px 0; background: var(--surface-0); border-bottom: 1px solid var(--border); }
nav.themes a { text-decoration: none; color: var(--text-secondary); font-size: 13px;
  border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px;
  background: var(--surface-1); }
nav.themes a:hover { color: var(--text-primary); border-color: var(--accent); }
details.hypotheses { margin-top: 12px; }
details.hypotheses ul { margin: 8px 0 0; padding-left: 18px; font-size: 13px;
  color: var(--text-secondary); }

/* Thèmes ----------------------------------------------------------------- */
section.theme { scroll-margin-top: 60px; margin-top: 28px; }
section.theme > header { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
  margin-bottom: 10px; }
h2.theme-title { font-size: 20px; margin: 0; }
.question { color: var(--text-secondary); font-size: 14px; margin: 0; }
.card { background: var(--surface-1); border: 1px solid var(--border);
  border-radius: 12px; padding: 16px; min-width: 0; }

/* Bandeau de KPI : les tuiles de chaque ligne se partagent toute la largeur,
   la dernière ligne comprise, pour ne jamais laisser de case vide. ------- */
.kpis { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
.kpi { flex: 1 1 180px; display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; }
.kpi .label { font-size: 12.5px; color: var(--text-secondary); line-height: 1.3; }
.kpi .value { font-size: 24px; font-weight: 650; line-height: 1.2; margin-top: 2px;
  font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.kpi .unit { font-size: 13px; font-weight: 500; color: var(--text-secondary); }
.kpi .detail, .kpi .delta { font-size: 12px; color: var(--text-muted); }
.kpi .delta { color: var(--text-secondary); font-variant-numeric: tabular-nums; }
.kpi a { font-size: 12px; color: var(--accent); margin-top: auto; padding-top: 4px; }
.code { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: .02em;
  color: var(--accent); background: var(--accent-soft); border-radius: 5px;
  padding: 1px 5px; margin-right: 6px; vertical-align: 1px; }

/* Graphiques : deux par ligne, cartes étirées à la même hauteur --------- */
.grid { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid .wide { grid-column: 1 / -1; }
@media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
.chart-card { display: flex; flex-direction: column; }
.chart-card h3 { margin: 0; font-size: 15px; }
.definition { color: var(--text-secondary); font-size: 12.5px; margin: 2px 0 6px; }
.chart-card .footer { margin-top: auto; }
.notes { margin: 6px 0 0; padding-left: 18px; color: var(--text-secondary); font-size: 12px; }
details { margin-top: 6px; }
summary { cursor: pointer; font-size: 13px; color: var(--accent); }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13px;
  font-variant-numeric: tabular-nums; margin-top: 8px; }
th, td { text-align: left; padding: 5px 10px; border-bottom: 1px solid var(--border); }
th { color: var(--text-secondary); font-weight: 600; }
td:not(:first-child), th:not(:first-child) { text-align: right; }
h4 { font-size: 13px; margin: 14px 0 0; color: var(--text-secondary); }
.export { display: inline-block; margin-top: 8px; border: 1px solid var(--accent);
  border-radius: 6px; padding: 5px 10px; font: inherit; font-size: 13px;
  color: var(--accent); background: transparent; cursor: pointer; align-self: flex-start; }
.export:hover { color: var(--surface-1); background: var(--accent); }

/* Définitions et exclusions en pied de thème --------------------------- */
.theme-footer { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline;
  margin-top: 8px; font-size: 12px; color: var(--text-muted); }
.theme-footer details { margin: 0; }
.theme-footer dl { margin: 6px 0 0; display: grid; grid-template-columns: auto 1fr;
  gap: 4px 10px; font-size: 13px; color: var(--text-secondary); }
.theme-footer dt { font-weight: 600; color: var(--text-primary); white-space: nowrap; }
.theme-footer dd { margin: 0; }
footer { margin-top: 32px; font-size: 12px; color: var(--text-muted); }
</style>
{{ plotly_script | safe }}
</head>
<body>
<main>
{% block content %}{% endblock %}
</main>
<script>
// Plotly ne lit pas les variables CSS : à chaque changement de mode, les
// couleurs des graphiques sont recalculées à partir des mêmes jetons.
(function () {
  var SERIES_DARK = {{ series_dark | tojson }};
  var SERIES_LIGHT = {};
  Object.keys(SERIES_DARK).forEach(function (k) { SERIES_LIGHT[SERIES_DARK[k]] = k; });
  var root = document.documentElement;
  function css(name) { return getComputedStyle(root).getPropertyValue(name).trim(); }
  function isDark() { return root.getAttribute("data-theme") === "dark"; }
  function restyleCharts() {
    if (!window.Plotly) { return; }
    var table = isDark() ? SERIES_DARK : SERIES_LIGHT;
    var grid = css("--chart-grid");
    document.querySelectorAll(".js-plotly-plot").forEach(function (el) {
      var layout = { "font.color": css("--chart-text") };
      Object.keys(el.layout).forEach(function (key) {
        if (/^[xy]axis\d*$/.test(key)) {
          layout[key + ".gridcolor"] = grid;
          layout[key + ".zerolinecolor"] = grid;
          layout[key + ".linecolor"] = grid;
        }
      });
      Plotly.relayout(el, layout);
      el.data.forEach(function (trace, i) {
        var update = {};
        if (trace.marker && typeof trace.marker.color === "string") {
          update["marker.color"] = table[trace.marker.color] || trace.marker.color;
        }
        if (trace.line && trace.line.color) {
          update["line.color"] = table[trace.line.color] || trace.line.color;
        }
        Plotly.restyle(el, update, [i]);
      });
      Plotly.Plots.resize(el);
    });
  }
  function setTheme(theme) {
    root.setAttribute("data-theme", theme);
    try { localStorage.setItem("sid-theme", theme); } catch (e) {}
    document.querySelectorAll("[data-set-theme]").forEach(function (b) {
      b.setAttribute("aria-pressed", String(b.getAttribute("data-set-theme") === theme));
    });
    restyleCharts();
  }
  document.querySelectorAll("[data-set-theme]").forEach(function (b) {
    b.addEventListener("click", function () { setTheme(b.getAttribute("data-set-theme")); });
  });
  window.addEventListener("load", function () { setTheme(isDark() ? "dark" : "light"); });
})();

// L'export 3.4.4 est construit au clic depuis le tableau HTML : aucun fichier
// annexe ni serveur web n'est nécessaire.
(function () {
  function csvCell(value) {
    return '"' + value.replace(/"/g, '""') + '"';
  }
  document.querySelectorAll("[data-csv-filename]").forEach(function (button) {
    button.addEventListener("click", function () {
      var container = button.parentElement.querySelector("[data-csv-table]");
      var rows = Array.from(container.querySelectorAll("tr")).map(function (row) {
        return Array.from(row.querySelectorAll("th, td")).map(function (cell) {
          return csvCell(cell.textContent.trim());
        }).join(";");
      });
      var blob = new Blob(["﻿" + rows.join("
") + "
"],
                          {type: "text/csv;charset=utf-8"});
      var url = URL.createObjectURL(blob);
      var link = document.createElement("a");
      link.href = url;
      link.download = button.dataset.csvFilename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    });
  });
})();
</script>
</body>
</html>
