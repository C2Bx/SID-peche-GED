<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if refresh_seconds %}<meta http-equiv="refresh" content="{{ refresh_seconds }}">{% endif %}
<title>{{ title }}</title>
<style>
:root {
  color-scheme: light;
  --surface-0: #f4f3f0;
  --surface-1: #fcfcfb;
  --border: #e4e3df;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --text-muted: #7a7974;
  --accent: #2a78d6;
  --good: #1a7f37;
  --critical: #c62828;
  --chart-text: #52514e;
  --chart-grid: #e4e3df;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --surface-0: #121211;
    --surface-1: #1a1a19;
    --border: #383835;
    --text-primary: #ffffff;
    --text-secondary: #c3c2b7;
    --text-muted: #8f8e86;
    --accent: #3987e5;
    --good: #4cc26a;
    --critical: #ef6b6b;
    --chart-text: #c3c2b7;
    --chart-grid: #383835;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #121211;
  --surface-1: #1a1a19;
  --border: #383835;
  --text-primary: #ffffff;
  --text-secondary: #c3c2b7;
  --text-muted: #8f8e86;
  --accent: #3987e5;
  --good: #4cc26a;
  --critical: #ef6b6b;
  --chart-text: #c3c2b7;
  --chart-grid: #383835;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--surface-0);
  color: var(--text-primary);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 1240px; margin: 0 auto; padding: 32px 16px 64px; }
header.page { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: end;
  justify-content: space-between; margin-bottom: 24px; }
h1 { font-size: 26px; line-height: 1.2; margin: 0 0 4px; letter-spacing: -0.01em; }
h2 { font-size: 16px; margin: 0; }
.meta, .subtitle, .note { color: var(--text-secondary); font-size: 13px; margin: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px;
  font-size: 12px; color: var(--text-secondary); background: var(--surface-1); }
.card { background: var(--surface-1); border: 1px solid var(--border);
  border-radius: 12px; padding: 16px; min-width: 0; }
.kpis { display: grid; gap: 12px; margin-bottom: 16px;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
.kpi .label { font-size: 13px; color: var(--text-secondary); }
.kpi .value { font-size: 26px; white-space: nowrap; font-weight: 600; line-height: 1.2;
  font-variant-numeric: tabular-nums; margin: 4px 0 2px; }
.kpi .unit { font-size: 14px; font-weight: 500; color: var(--text-secondary); }
.kpi .detail { font-size: 12px; color: var(--text-muted); }
.grid { display: grid; gap: 16px; align-items: start; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid .wide { grid-column: 1 / -1; }
@media (max-width: 860px) { .grid { grid-template-columns: minmax(0, 1fr); } }
.card header { margin-bottom: 8px; }
.note { margin-top: 8px; padding-left: 10px; border-left: 3px solid var(--border); }
details { margin-top: 8px; }
summary { cursor: pointer; font-size: 13px; color: var(--accent); }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13px;
  font-variant-numeric: tabular-nums; margin-top: 8px; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); }
th { color: var(--text-secondary); font-weight: 600; }
td:not(:first-child), th:not(:first-child) { text-align: right; }
td.text, th.text { text-align: left; }
.status { font-weight: 600; white-space: nowrap; }
.status.ok { color: var(--good); }
.status.ko { color: var(--critical); }
.warning { background: var(--surface-1); border: 1px solid var(--border);
  border-left: 4px solid var(--accent); border-radius: 8px; padding: 10px 14px;
  font-size: 13px; color: var(--text-secondary); margin-bottom: 16px; }
nav.themes { position: sticky; top: 0; z-index: 5; display: flex; gap: 6px;
  flex-wrap: wrap; padding: 10px 0; margin-bottom: 8px; background: var(--surface-0); }
nav.themes a { text-decoration: none; color: var(--text-secondary); font-size: 13px;
  border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px;
  background: var(--surface-1); }
nav.themes a:hover { color: var(--text-primary); border-color: var(--accent); }
section.theme { scroll-margin-top: 56px; margin: 28px 0 8px; }
section.theme > header { margin-bottom: 12px; }
h2.theme-title { font-size: 20px; margin: 0; }
.code { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .02em;
  color: var(--accent); border: 1px solid var(--border); border-radius: 6px;
  padding: 1px 6px; margin-right: 6px; vertical-align: 2px; }
.definition { color: var(--text-secondary); font-size: 13px; margin: 2px 0 10px; }
.mini-kpis { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 4px 0 8px; }
.mini-kpis .value { font-size: 24px; }
.notes { margin: 8px 0 0; padding-left: 18px; color: var(--text-secondary); font-size: 12px; }
.excluded { font-size: 12px; color: var(--text-muted); margin-top: 8px; }
h4 { font-size: 13px; margin: 14px 0 0; color: var(--text-secondary); }
.export { display: inline-block; margin-top: 8px; border: 1px solid var(--accent);
  border-radius: 6px; padding: 5px 10px; font: inherit; font-size: 13px;
  color: var(--accent); background: transparent; cursor: pointer; }
.export:hover { color: var(--surface-1); background: var(--accent); }
details.hypotheses summary { font-size: 14px; }
details.hypotheses ul { margin: 8px 0 0; padding-left: 18px; font-size: 13px;
  color: var(--text-secondary); }
footer { margin-top: 32px; font-size: 12px; color: var(--text-muted); }
</style>
{{ plotly_script | safe }}
</head>
<body>
<main>
{% block content %}{% endblock %}
</main>
<script>
// Plotly ne lit pas les variables CSS : la charte sombre est appliquée ici,
// à partir des mêmes jetons, et suit les changements de thème du système.
(function () {
  var SERIES_DARK = {{ series_dark | tojson }};
  var SERIES_LIGHT = {};
  Object.keys(SERIES_DARK).forEach(function (k) { SERIES_LIGHT[SERIES_DARK[k]] = k; });
  function css(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function swap(color, table) { return table[color] || color; }
  function apply() {
    var dark = css("color-scheme") === "dark";
    var table = dark ? SERIES_DARK : SERIES_LIGHT;
    document.querySelectorAll(".js-plotly-plot").forEach(function (el) {
      var grid = css("--chart-grid");
      var layout = { "font.color": css("--chart-text") };
      Object.keys(el.layout).forEach(function (key) {
        if (/^[xy]axis\d*$/.test(key)) {
          layout[key + ".gridcolor"] = grid;
          layout[key + ".zerolinecolor"] = grid;
          layout[key + ".linecolor"] = grid;
        }
      });
      Plotly.relayout(el, layout);
      el.data.forEach(function (trace, i) {
        var update = {};
        if (trace.marker && typeof trace.marker.color === "string") {
          update["marker.color"] = swap(trace.marker.color, table);
        }
        if (trace.line && trace.line.color) {
          update["line.color"] = swap(trace.line.color, table);
        }
        if (trace.marker && trace.marker.line) {
          update["marker.line.color"] = css("--surface-1");
        }
        Plotly.restyle(el, update, [i]);
      });
      // La figure est dessinée avant la mise en page de la grille : on la
      // recale sur la largeur réelle de sa carte.
      Plotly.Plots.resize(el);
    });
  }
  window.addEventListener("load", apply);
  if (window.matchMedia) {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", apply);
  }
})();

// L'export 3.4.4 est construit au clic depuis le tableau HTML : aucun fichier
// annexe ni serveur web n'est nécessaire.
(function () {
  function csvCell(value) {
    return '"' + value.replace(/"/g, '""') + '"';
  }
  document.querySelectorAll("[data-csv-filename]").forEach(function (button) {
    button.addEventListener("click", function () {
      var container = button.parentElement.querySelector("[data-csv-table]");
      var rows = Array.from(container.querySelectorAll("tr")).map(function (row) {
        return Array.from(row.querySelectorAll("th, td")).map(function (cell) {
          return csvCell(cell.textContent.trim());
        }).join(";");
      });
      var blob = new Blob(["\ufeff" + rows.join("\r\n") + "\r\n"],
                          {type: "text/csv;charset=utf-8"});
      var url = URL.createObjectURL(blob);
      var link = document.createElement("a");
      link.href = url;
      link.download = button.dataset.csvFilename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    });
  });
})();
</script>
</body>
</html>
