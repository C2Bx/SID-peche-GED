{% extends "base.html.j2" %}
{% block content %}
<header class="page">
  <div>
    <h1>{{ title }}</h1>
    <p class="meta">Date de référence : <strong>{{ date_ref }}</strong> · Source : {{ source }} · généré le {{ generated_at }}{% if refresh_seconds %} · actualisation automatique{% endif %}</p>
  </div>
  <div class="theme-toggle" role="group" aria-label="Mode d'affichage">
    <button type="button" data-set-theme="light" aria-pressed="true">☀ Jour</button>
    <button type="button" data-set-theme="dark" aria-pressed="false">☾ Nuit</button>
  </div>
</header>

<nav class="themes" aria-label="Thèmes">
  {% for theme in themes %}<a href="#{{ theme.id }}">{{ theme.titre }}</a>{% endfor %}
</nav>

<details class="card hypotheses">
  <summary>Règles de calcul et hypothèses retenues</summary>
  <ul>{% for h in hypotheses %}<li>{{ h }}</li>{% endfor %}</ul>
</details>

{% for theme in themes %}
<section class="theme" id="{{ theme.id }}">
  <header>
    <h2 class="theme-title">{{ theme.titre }}</h2>
    <p class="question">{{ theme.question }}</p>
  </header>

  <div class="kpis">
    {% for kpi in theme.kpis %}
    <div class="card kpi">
      <div class="label"><span class="code">{{ kpi.code }}</span>{{ kpi.label }}</div>
      <div class="value">{{ kpi.value }}{% if kpi.unit %} <span class="unit">{{ kpi.unit }}</span>{% endif %}</div>
      {% if kpi.delta %}<div class="delta">{{ kpi.delta }}</div>{% endif %}
      {% if kpi.detail %}<div class="detail">{{ kpi.detail }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="grid">
    {% for carte in theme.cartes %}
    <article class="card chart-card{% if carte.wide %} wide{% endif %}">
      <h3><span class="code">{{ carte.code }}</span>{{ carte.titre }}</h3>
      <p class="definition">{{ carte.definition }}</p>
      {{ carte.chart_html | safe }}
      {% if carte.table_visible %}
      <div class="table-wrap" data-csv-table>{{ carte.table_html | safe }}</div>
      {% endif %}
      {% if carte.csv_export %}
      <button class="export" type="button"
              data-csv-filename="campagnes_actives_{{ date_ref_iso }}.csv">Exporter en CSV</button>
      {% endif %}
      <div class="footer">
        {% if carte.notes %}<ul class="notes">{% for n in carte.notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
        {% if carte.table_html and not carte.table_visible %}
        <details>
          <summary>Voir les chiffres</summary>
          <div class="table-wrap">{{ carte.table_html | safe }}</div>
        </details>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>

  <div class="theme-footer">
    <details>
      <summary>Définitions des indicateurs</summary>
      <dl>{% for code, titre, definition in theme.definitions %}<dt>{{ code }} {{ titre }}</dt><dd>{{ definition }}</dd>{% endfor %}</dl>
    </details>
    {% if theme.exclus %}<span>Exclus par le SFD : {{ theme.exclus | join(", ") }}.</span>{% endif %}
  </div>
</section>
{% endfor %}

<footer>
  Généré par <code>python -m src.reporting.build_report</code> · indicateurs conformes à la fiche « Indicateurs de la restitution »
</footer>
{% endblock %}
